# Todas as chaves abaixo são opcionais.
# Sem elas, as checagens correspondentes aparecem no relatório como "não configurado"
# em vez de quebrar o resto do diagnóstico.

# https://www.abuseipdb.com/ (checagem de reputação de IP — v2)
ABUSEIPDB_API_KEY=

# https://www.shodan.io/ (checagem de exposição de IP — v2)
SHODAN_API_KEY=

# https://haveibeenpwned.com/API/Key (e-mails do domínio em vazamentos conhecidos)
HIBP_API_KEY=

# https://github.com/settings/tokens (busca de chaves/senhas vazadas em repositórios públicos)
GITHUB_TOKEN=

# https://console.twilio.com/ (Account SID e Auth Token — reputação/tipo de linha de número de telefone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
