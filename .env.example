# Todas as chaves abaixo são opcionais para rodar localmente.
# Sem elas, as checagens correspondentes aparecem no relatório como "não configurado"
# em vez de quebrar o resto do diagnóstico.

# ---------------------------------------------------------------- site e conta
# Endereço público do site. Os links de entrada e dos avisos são montados a partir
# DESTE valor (nunca do cabeçalho Host da requisição). Obrigatório em produção.
APP_BASE_URL=http://localhost:8000
# Segredo para o código (HMAC) dos IPs no limite de uso. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Onde fica o banco SQLite (no Fly.io: /data/checkup.db, num volume — ver fly.toml)
DATABASE_PATH=data/checkup.db
# Redis compartilhado para limite de uso e cooldown (necessário com mais de 1 máquina)
REDIS_URL=

# Quem é o controlador dos dados (aparece na página /privacidade)
CONTROLLER_NAME=Nebula Host
CONTROLLER_DOCUMENT=
PRIVACY_CONTACT_EMAIL=
# Para onde aponta o "Falar com a Nebula Host" no relatório
HELP_URL=https://nebulahost.com.br

# ---------------------------------------------------------------- e-mail (Resend)
# https://resend.com — envia o link de entrada e os avisos do monitoramento
RESEND_API_KEY=
EMAIL_FROM=Diagnóstico Nebula Host <nao-responda@nebulahost.com.br>
# SÓ EM DESENVOLVIMENTO: mostra o link de entrada na tela (sem precisar de e-mail)
DEV_SHOW_LOGIN_LINK=

# ---------------------------------------------------------------- monitoramento
# A cada quantos dias cada domínio comprovado é verificado de novo
MONITOR_INTERVAL_DAYS=7
# Segredo do gatilho POST /tarefas/monitor (chamado pelo GitHub Actions)
CRON_SECRET=

# ---------------------------------------------------------------- WhatsApp Cloud API
# Mensagem iniciada pela empresa exige um modelo (template) aprovado pela Meta — ver README
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=alerta_seguranca
WHATSAPP_TEMPLATE_LANG=pt_BR

# ---------------------------------------------------------------- checagens
# https://haveibeenpwned.com/API/Key (e-mails do domínio em vazamentos conhecidos).
# A busca por domínio do HIBP só responde para domínios verificados no painel da chave.
HIBP_API_KEY=

# https://github.com/settings/tokens (busca de chaves/senhas vazadas em repositórios públicos)
GITHUB_TOKEN=

# https://console.twilio.com/ (Account SID e Auth Token — tipo de linha de número suspeito)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# https://dash.cloudflare.com/?to=/:account/turnstile (CAPTCHA do formulário — recomendado antes de divulgar publicamente)
# TURNSTILE_SITE_KEY é pública (vai no HTML), TURNSTILE_SECRET_KEY é privada (nunca commitar).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Portas e falhas do servidor vêm do Shodan InternetDB, que não precisa de chave.
# https://www.abuseipdb.com/ (reputação de IP — roadmap)
ABUSEIPDB_API_KEY=
